# Arquivo local ignorado pelo Git. Nao compartilhe, nao versione e nao cole em issues/prints.
# Alinhado ao env.example; valores reais ficam somente aqui ou no painel do Vercel.

# Backend obrigatorio
GOOGLE_SHEET_IDS=
LOGIN_SHEET_NAME=Base de dados
SESSION_SECRET=
COOKIE_SECURE=true

# acesso a documentação
DOCS_USERNAME=
DOCS_PASSWORD=

# Cloudflare Turnstile opcional. Se as duas chaves ficarem vazias, o login nao usa captcha.
# Em producao, configure as duas chaves. Para teste local com widget, use as chaves dummy da documentacao.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Credencial Google obrigatoria. Use exatamente uma opcao ativa.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Desenvolvimento local
PORT=3000
